<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>remetric report - http://prom:9090</title>
<style>:root { color-scheme: light dark; --bg:#fff; --fg:#222; --muted:#666; --accent:#0a58ca; }
@media (prefers-color-scheme: dark) { :root { --bg:#111; --fg:#eee; --muted:#aaa; --accent:#7aa6ff; } }
body { font-family: -apple-system, system-ui, sans-serif; margin: 0; padding: 1.5rem; background: var(--bg); color: var(--fg); max-width: 64rem; margin: 0 auto; }
header h1 { margin: 0 0 .25rem; }
.target, .meta { color: var(--muted); margin: 0 0 1rem; }
.warnings { background: #fff3cd; color: #664d03; padding: .75rem 1rem; border-left: 4px solid #f0c14b; margin: 1rem 0; }
.summary { display: flex; gap: 2rem; align-items: center; margin: 1.5rem 0; flex-wrap: wrap; }
.donut svg { width: 8rem; height: 8rem; }
.severity-counts { border-collapse: collapse; }
.severity-counts th, .severity-counts td { padding: .25rem .75rem; text-align: left; }
.filters { display: flex; gap: 2rem; margin: 1rem 0; flex-wrap: wrap; }
.filters fieldset { border: 1px solid var(--muted); padding: .5rem .75rem; }
.finding { border: 1px solid #ddd; border-radius: 4px; margin: .5rem 0; padding: .25rem .5rem; }
.finding summary { cursor: pointer; display: flex; gap: .5rem; align-items: center; }
.badge { display: inline-block; padding: .1rem .4rem; border-radius: 2px; font-size: .75rem; font-weight: bold; text-transform: uppercase; }
.badge.sev-CRITICAL { background: #d9534f; color: #fff; }
.badge.sev-HIGH { background: #f0ad4e; color: #fff; }
.badge.sev-MEDIUM { background: #5bc0de; color: #fff; }
.badge.sev-LOW { background: #5cb85c; color: #fff; }
.fix { background: #f6f8fa; padding: .5rem; overflow-x: auto; border-radius: 3px; }
@media (max-width: 720px) {
  body { padding: .75rem; }
  .summary, .filters { flex-direction: column; gap: .75rem; }
}
nav.filters:has(input[data-sev="CRITICAL"]:not(:checked)) ~ #findings details.sev-CRITICAL { display: none; }
nav.filters:has(input[data-sev="HIGH"]:not(:checked)) ~ #findings details.sev-HIGH { display: none; }
nav.filters:has(input[data-sev="MEDIUM"]:not(:checked)) ~ #findings details.sev-MEDIUM { display: none; }
nav.filters:has(input[data-sev="LOW"]:not(:checked)) ~ #findings details.sev-LOW { display: none; }
</style>
</head>
<body>
<header>
  <h1>remetric report</h1>
  <p class="target">http://prom:9090 <span class="ver">(Prometheus 2.51.2)</span></p>
  <p class="meta">Scanned 2026-05-21 12:00 UTC · remetric v0.1.0</p>
</header>


<aside class="warnings">
  <h2>Warnings</h2>
  <ul><li>vmalert not configured</li></ul>
</aside>


<section class="summary">
  <div class="donut"><svg viewBox="0 0 32 32" role="img" aria-label="severity distribution"><circle cx="16" cy="16" r="12" fill="none" stroke="#d9534f" stroke-width="6" stroke-dasharray="18.850 56.549" stroke-dashoffset="-0.000" transform="rotate(-90 16 16)"/><circle cx="16" cy="16" r="12" fill="none" stroke="#f0ad4e" stroke-width="6" stroke-dasharray="18.850 56.549" stroke-dashoffset="-18.850" transform="rotate(-90 16 16)"/><circle cx="16" cy="16" r="12" fill="none" stroke="#5bc0de" stroke-width="6" stroke-dasharray="18.850 56.549" stroke-dashoffset="-37.699" transform="rotate(-90 16 16)"/><circle cx="16" cy="16" r="12" fill="none" stroke="#5cb85c" stroke-width="6" stroke-dasharray="18.850 56.549" stroke-dashoffset="-56.549" transform="rotate(-90 16 16)"/></svg></div>
  <table class="severity-counts">
    <tr><th>Critical</th><td>1</td></tr>
    <tr><th>High</th><td>1</td></tr>
    <tr><th>Medium</th><td>1</td></tr>
    <tr><th>Low</th><td>1</td></tr>
  </table>
</section>

<nav class="filters">
  <fieldset class="severity">
    <legend>Severity</legend>
    
      <label><input type="checkbox" checked data-sev="CRITICAL">CRITICAL</label>
    
      <label><input type="checkbox" checked data-sev="HIGH">HIGH</label>
    
      <label><input type="checkbox" checked data-sev="MEDIUM">MEDIUM</label>
    
      <label><input type="checkbox" checked data-sev="LOW">LOW</label>
    
  </fieldset>
  <fieldset class="category">
    <legend>Category</legend>
    
      <label><input type="checkbox" checked data-cat="alert_hygiene">alert_hygiene</label>
    
      <label><input type="checkbox" checked data-cat="cardinality">cardinality</label>
    
      <label><input type="checkbox" checked data-cat="label_patterns">label_patterns</label>
    
  </fieldset>
</nav>

<main id="findings">

  <details class="finding sev-CRITICAL" data-category="alert_hygiene">
    <summary>
      <span class="badge sev-CRITICAL">CRITICAL</span>
      <span class="title">Alert Broken firing 100.0% of window</span>
    </summary>
    <p class="evidence">firing 100% of 168h0m0s</p>
    <pre class="fix"><code>- alert: Broken
  expr: vector(1)</code></pre>
  </details>

  <details class="finding sev-MEDIUM" data-category="alert_hygiene">
    <summary>
      <span class="badge sev-MEDIUM">MEDIUM</span>
      <span class="title">Alert Noise never fired in 168h0m0s</span>
    </summary>
    <p class="evidence">no firing samples</p>
    <pre class="fix"><code>- alert: Noise
  expr: vector(0)</code></pre>
  </details>

  <details class="finding sev-HIGH" data-category="cardinality">
    <summary>
      <span class="badge sev-HIGH">HIGH</span>
      <span class="title">http_requests_total: 250k series</span>
    </summary>
    <p class="evidence">user_id unbounded</p>
    <pre class="fix"><code>- action: labeldrop
  regex: user_id</code></pre>
  </details>

  <details class="finding sev-LOW" data-category="label_patterns">
    <summary>
      <span class="badge sev-LOW">LOW</span>
      <span class="title">Label trace_id looks unbounded</span>
    </summary>
    <p class="evidence">1M unique values across 5 metrics</p>
    <pre class="fix"><code>- action: labeldrop
  regex: trace_id</code></pre>
  </details>

</main>

<script>(() => {
  const filters = document.querySelector('.filters');
  if (!filters) return;
  filters.addEventListener('change', () => {
    const allowedSev = new Set(Array.from(filters.querySelectorAll('input[data-sev]:checked')).map(i => i.dataset.sev));
    const allowedCat = new Set(Array.from(filters.querySelectorAll('input[data-cat]:checked')).map(i => i.dataset.cat));
    document.querySelectorAll('#findings details').forEach(d => {
      const sev = (d.className.match(/sev-(\w+)/) || [, ''])[1];
      const cat = d.dataset.category || '';
      d.style.display = (allowedSev.has(sev) && allowedCat.has(cat)) ? '' : 'none';
    });
  });
})();
</script>
</body>
</html>
