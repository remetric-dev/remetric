    {
      "id": 2,
      "type": "stat",
      "title": "Filesystem available",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [
        {"expr": "node_filesystem_avail_bytes", "refId": "A"}
      ]
    }
  ]
}
